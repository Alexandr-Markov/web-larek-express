# Порт сервера
PORT=3000

# Адрес подключения к MongoDB
# Локально:
DB_ADDRESS=mongodb://127.0.0.1:27017/weblarek
# Если запускаем в Docker:
# DB_ADDRESS=mongodb://root:example@mongo:27017/

# Временная папка для загруженных файлов
TMP_DIR=src/tmp
# Конечная папка с картинками
IMAGES_DIR=src/public/images

# Разрешённый источник для CORS
CORS_URL=http://localhost:5173

# JWT
JWT_SECRET=ваш_секретный_ключ
AUTH_ACCESS_TOKEN_EXPIRY=1m
AUTH_REFRESH_TOKEN_EXPIRY=7d